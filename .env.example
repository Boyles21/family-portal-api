# --- Cookies ---
# Frontend and API on the same registrable domain (app.x.com + api.x.com): leave lax and set the domain.
COOKIE_DOMAIN=.onrender.com
COOKIE_SAMESITE=lax
# Frontend and API on DIFFERENT domains (e.g. vercel.app + onrender.com): set this to none (HTTPS only).
# COOKIE_SAMESITE=none

# --- Photos, audio and documents (any S3-compatible bucket, e.g. Cloudflare R2). Without it, uploads return 501. ---
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Real push notifications. Generate keys with:  npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
